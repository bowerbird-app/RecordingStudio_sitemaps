<% workspace_title = @workspace&.name.presence || "Workspace" %>
<% content_for :title, workspace_title %>
<% content_for :subtitle, (@workspace.present? ? "Folders and pages in this workspace." : "Pick a workspace from the switcher.") %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  back_href: root_path,
  anchor_href: root_path
) %>

<div class="flex w-full flex-col gap-6">
  <% if @workspace_items.any? %>
    <%= render FlatPack::List::Component.new(divider: true) do %>
      <% @workspace_items.each do |item| %>
        <%= render FlatPack::List::Item.new(trailing: item.fetch(:kind)) do %>
          <%= item.fetch(:name) %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "Nothing here yet",
      description: "Folders and pages in this workspace will show up here."
    ) %>
  <% end %>
</div>
